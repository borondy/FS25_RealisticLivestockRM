            </visuals>
            <reproduction supported="false" minAgeMonth="5"/>
            <buyPrice>
                <key ageMonth="0" value="70"/>
                <key ageMonth="36" value="900"/>
            </buyPrice>
            <sellPrice>
                <key ageMonth="0" value="55"/>
                <key ageMonth="36" value="750"/>
            </sellPrice>
            <transportPrice>
                <key ageMonth="0" value="50"/>
                <key ageMonth="8" value="125"/>
                <key ageMonth="18" value="200"/>
            </transportPrice>
            <input>
                <straw>
                    <key ageMonth="0" value="3"/>
                    <key ageMonth="5" value="20"/>
                    <key ageMonth="18" value="40"/>
                </straw>
                <water>
                    <key ageMonth="0" value="3"/>
                    <key ageMonth="5" value="42"/>
                    <key ageMonth="18" value="70"/>
                </water>
                <food>
                    <key ageMonth="0" value="5"/>
                    <key ageMonth="5" value="50"/>
                    <key ageMonth="18" value="120"/>
                </food>
            </input>
            <output>
                <manure>
                    <key ageMonth="0" value="5"/>
                    <key ageMonth="5" value="16"/>
                    <key ageMonth="18" value="35"/>
                </manure>
                <pallets fillType="WOOL">
                    <key ageMonth="0" value="0"/>
                    <key ageMonth="6" value="15"/>
                    <key ageMonth="18" value="85"/>
                </pallets>
            </output>
        </subType>

        <!-- New: RAM_SUFFOLK -->
        <subType subType="RAM_SUFFOLK" fillTypeName="RAM_SUFFOLK"
                 gender="male" breed="SUFFOLK"
                 minWeight="5.0" targetWeight="70.0" maxWeight="150.0">
            <visuals>
                <visual minAge="0" visualAnimalIndex="4" name="$l10n_animal_visual_baby"
                        image="$dataS/character/animals/domesticated/sheep/store_sheepSteinschafBaby.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_ramSuffolkLambDesc</description>
                </visual>
                <visual minAge="3" visualAnimalIndex="5" name="$l10n_animal_visual_kid"
                        image="$dataS/character/animals/domesticated/sheep/store_sheepSteinschafKid.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_ramSuffolkYoungDesc</description>
                </visual>
                <visual minAge="8" visualAnimalIndex="6" name="$l10n_animal_visual_adult"
                        image="$dataS/character/animals/domesticated/sheep/store_sheepSteinschaf.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_ramSuffolkAdultDesc</description>
                </visual>
            </visuals>
            <reproduction supported="false" minAgeMonth="5"/>
            <buyPrice>
                <key ageMonth="0" value="65"/>
                <key ageMonth="36" value="850"/>
            </buyPrice>
            <sellPrice>
                <key ageMonth="0" value="50"/>
                <key ageMonth="36" value="700"/>
            </sellPrice>
            <transportPrice>
                <key ageMonth="0" value="50"/>
                <key ageMonth="8" value="125"/>
                <key ageMonth="18" value="200"/>
            </transportPrice>
            <input>
                <straw>
                    <key ageMonth="0" value="3"/>
                    <key ageMonth="5" value="18"/>
                    <key ageMonth="18" value="36"/>
                </straw>
                <water>
                    <key ageMonth="0" value="3"/>
                    <key ageMonth="5" value="38"/>
                    <key ageMonth="18" value="65"/>
                </water>
                <food>
                    <key ageMonth="0" value="4"/>
                    <key ageMonth="5" value="46"/>
                    <key ageMonth="18" value="110"/>
                </food>
            </input>
            <output>
                <manure>
                    <key ageMonth="0" value="5"/>
                    <key ageMonth="5" value="14"/>
                    <key ageMonth="18" value="32"/>
                </manure>
                <pallets fillType="WOOL">
                    <key ageMonth="0" value="0"/>
                    <key ageMonth="6" value="12"/>
                    <key ageMonth="18" value="75"/>
                </pallets>
            </output>
        </subType>

        <!-- New: RAM_BLUE_FACED_LEICESTER -->
        <subType subType="RAM_BLUE_FACED_LEICESTER" fillTypeName="RAM_BLUE_FACED_LEICESTER"
                 gender="male" breed="BLUE_FACED_LEICESTER"
                 minWeight="4.5" targetWeight="55.0" maxWeight="150.0">
            <visuals>
                <visual minAge="0" visualAnimalIndex="1" name="$l10n_animal_visual_baby"
                        image="map/config/sheep/store_sheepBlueFacedLeicesterBaby.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_ramBFLLambDesc</description>
                </visual>
                <visual minAge="3" visualAnimalIndex="2" name="$l10n_animal_visual_kid"
                        image="map/config/sheep/store_sheepBlueFacedLeicesterKid.png"
                        canBeBought="true">
