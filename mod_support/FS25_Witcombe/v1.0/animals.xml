    <!-- ======================================================================
         RABBIT: New male subtype + pregnancy/weight overrides
         navMesh h=0.3, r=0.2 gives absurd derived weights: max=45, target=18
         Real domestic rabbits: 2-5kg
         ====================================================================== -->
    <animal type="RABBIT">
        <pregnancy average="4" max="8"/>

        <!-- Override: fix existing RABBIT (female) weights, breed, and consumption rates.
             Witcombe map's original input is sheep-scaled (16.5 L water/day, 15 L food/day adult)
             which collapses doe Health to 0% within hours. Mirror the buck's rabbit-scale rates. -->
        <subType subType="RABBIT" breed="RABBIT" minWeight="0.1" targetWeight="2.5" maxWeight="5.0">
            <input>
                <water>
                    <key ageMonth="0" value="0.1"/>
                    <key ageMonth="5" value="0.5"/>
                </water>
                <food>
                    <key ageMonth="0" value="0.2"/>
                    <key ageMonth="5" value="1.5"/>
                </food>
            </input>
        </subType>

        <!-- New: RABBIT_MALE -->
        <subType subType="RABBIT_MALE" fillTypeName="RABBIT_MALE"
                 gender="male" breed="RABBIT"
                 minWeight="0.1" targetWeight="3.0" maxWeight="5.5">
            <visuals>
                <visual minAge="0" visualAnimalIndex="2" name="$l10n_animal_visual_baby"
                        image="map/config/rabbits/store_baby_rabbit.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_rabbitMaleBabyDesc</description>
                </visual>
                <visual minAge="4" visualAnimalIndex="1" name="$l10n_animal_visual_adult"
                        image="map/config/rabbits/store_rabbit.png"
                        canBeBought="true">
                    <description>$l10n_rl_bridge_rabbitMaleDesc</description>
                </visual>
            </visuals>
            <reproduction supported="false" minAgeMonth="4"/>
            <buyPrice>
                <key ageMonth="0" value="18"/>
                <key ageMonth="36" value="70"/>
            </buyPrice>
            <sellPrice>
                <key ageMonth="0" value="12"/>
                <key ageMonth="36" value="55"/>
            </sellPrice>
            <transportPrice>
                <key ageMonth="0" value="5"/>
                <key ageMonth="8" value="15"/>
            </transportPrice>
            <input>
                <water>
                    <key ageMonth="0" value="0.1"/>
                    <key ageMonth="5" value="0.5"/>
                </water>
                <food>
                    <key ageMonth="0" value="0.2"/>
                    <key ageMonth="5" value="1.5"/>
                </food>
            </input>
        </subType>
    </animal>

</animals>
