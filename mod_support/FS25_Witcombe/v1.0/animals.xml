                </straw>
                <water>
                    <key ageMonth="0" value="2"/>
                    <key ageMonth="5" value="30"/>
                    <key ageMonth="18" value="55"/>
                </water>
                <food>
                    <key ageMonth="0" value="3"/>
                    <key ageMonth="5" value="35"/>
                    <key ageMonth="18" value="85"/>
                </food>
            </input>
            <output>
