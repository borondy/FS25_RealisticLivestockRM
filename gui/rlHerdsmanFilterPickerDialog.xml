<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    rlHerdsmanFilterPickerDialog.xml
    Single-select filter picker for a herdsman rule. Mirrors AnimalMoveDestinationDialog.xml
    (fs25_dialogBg shell, single-select SmoothList + slider, buttonsPC OK/Cancel) with a
    name-only list item. The frame supplies the already-scoped + alpha-sorted candidate list;
    this dialog only renders it. Inline list-item profiles (rl_herdFilter*) follow the
    move-dialog precedent - the "no new rlMenu_* profile" boundary is scoped to the Filter
    ROW in the frame, not this dialog.
-->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
	<GuiElement profile="newLayer"/>
	<Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
	<GuiElement profile="fs25_dialogBg" id="dialogElement" size="600px 740px">
		<ThreePartBitmap profile="fs25_dialogBgMiddle"/>
		<ThreePartBitmap profile="fs25_dialogBgTop"/>
		<ThreePartBitmap profile="fs25_dialogBgBottom"/>
		<GuiElement profile="fs25_dialogContentContainer">
			<Text profile="dialogTitle" text="$l10n_rl_menu_herdsman_filter_picker_title" id="dialogTitleElement" position="0px -30px"/>

			<!-- Empty state: shown when the operation has no usage-valid filters. -->
			<Text profile="fs25_dialogText" text="$l10n_rl_menu_herdsman_filter_picker_empty" id="emptyListText" position="0px -200px" size="500px 40px" visible="false"/>

			<!-- Single-select filter list (name only) -->
			<SmoothList profile="rl_herdFilterList" id="filterList" position="50px -80px" size="470px 550px" focusInit="onOpen" focusChangeTop="nil" focusChangeBottom="nil" onClick="onListClick">
				<ListItem profile="rl_herdFilterListItem" size="455px 55px">
					<Text profile="rl_herdFilterName" position="10px 0px" size="435px 55px" name="filterName"/>
				</ListItem>
			</SmoothList>

			<!-- Scrollbar (hidden with the list on the empty state) -->
			<ThreePartBitmap profile="fs25_listSliderBox" id="filterSliderBox" position="-30px -17px" size="12px 550px" with="anchorTopRight">
				<Slider profile="fs25_listSlider" size="6px 542px" dataElementId="filterList"/>
			</ThreePartBitmap>
		</GuiElement>

		<BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
			<Button profile="buttonOK" text="$l10n_button_confirm" onClick="onClickConfirm" id="confirmButton"/>
			<Bitmap profile="fs25_dialogButtonBoxSeparator"/>
			<Button profile="buttonBack" text="$l10n_button_back" onClick="onClickCancel"/>
		</BoxLayout>
	</GuiElement>

	<GUIProfiles>
		<Profile name="rl_herdFilterList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
		</Profile>
		<Profile name="rl_herdFilterListItem" extends="baseReference" with="anchorTopStretchingX alternating">
			<height value="55px"/>
			<imageColor value="$preset_fs25_colorGrey"/>
			<imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
			<alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
		</Profile>
		<Profile name="rl_herdFilterName" extends="baseReference" with="anchorMiddleLeft">
			<textBold value="false"/>
			<textSize value="18px"/>
			<textAlignment value="left"/>
			<textColor value="$preset_fs25_colorMainLight"/>
			<textSelectedColor value="$preset_fs25_colorMainDark"/>
		</Profile>
	</GUIProfiles>
</GUI>
